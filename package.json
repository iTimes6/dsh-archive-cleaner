{
  "name": "dsh-archive-cleaner",
  "version": "0.1.1",
  "description": "侧边栏里的归档会话清理面板：勾选后永久删除 DSH 里已归档的会话。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-better-sidebar",
    "sessions",
    "archive",
    "cleanup"
  ],
  "author": "iTimes6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iTimes6/dsh-archive-cleaner.git"
  },
  "homepage": "https://github.com/iTimes6/dsh-archive-cleaner#readme",
  "bugs": {
    "url": "https://github.com/iTimes6/dsh-archive-cleaner/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  }
}
